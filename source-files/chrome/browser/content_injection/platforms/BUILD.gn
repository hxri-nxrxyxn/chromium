# Per-platform content injection rule files.
#
# To add a new platform:
#   1. Create platforms/<name>_rules.h + platforms/<name>_rules.cc
#   2. Add both to the |sources| list below.
#   3. Include the header in content_injection_rules.cc and call
#      Get<Name>InjectionRules() in the Append() sequence.
#
# No other BUILD files need to change.

source_set("platforms") {
  sources = [
    # ── Per-platform rule files (alphabetical) ───────────────────────────────
    "facebook_rules.h",
    "facebook_rules.cc",
    "instagram_rules.h",
    "instagram_rules.cc",
    "linkedin_rules.h",
    "linkedin_rules.cc",
    "reddit_rules.h",
    "reddit_rules.cc",
    "tumblr_rules.h",
    "tumblr_rules.cc",
    "x_rules.h",
    "x_rules.cc",
    "youtube_rules.h",
    "youtube_rules.cc",
  ]

  deps = [
    "//base",
    "//chrome/browser/content_injection:injection_rule_types",
  ]
}
